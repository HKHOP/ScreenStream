<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Streaming Engine Configuration">
        
        <SwitchPreferenceCompat
            app:key="use_rtsp_mode"
            app:title="Enable RTSP Streaming"
            app:summary="Switch from traditional HTTP MJPEG streaming to an RTSP server layer"
            app:defaultValue="false" />
            
        <EditTextPreference
            app:key="rtsp_port"
            app:title="RTSP Server Port"
            app:dialogTitle="Set Server Port"
            app:defaultValue="1935"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="jpeg_quality"
            app:title="JPEG Quality (10-100)"
            app:dialogTitle="Set JPEG Quality"
            app:defaultValue="75"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="stream_fps"
            app:title="Frame Rate (FPS 5-60)"
            app:dialogTitle="Set Frame Rate"
            app:defaultValue="30"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="stream_latency_ms"
            app:title="Frame Latency (ms 0-1000)"
            app:dialogTitle="Set Target Latency"
            app:defaultValue="33"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="stream_scale"
            app:title="Resolution Scale (0.2-1.0)"
            app:dialogTitle="Set Resolution Scale"
            app:defaultValue="0.6"
            app:useSimpleSummaryProvider="true" />
            
    </PreferenceCategory>

    <PreferenceCategory app:title="Audio Configuration">

        <SwitchPreferenceCompat
            app:key="enable_audio"
            app:title="Enable Audio"
            app:summary="Include audio track in streams when supported"
            app:defaultValue="false" />

        <ListPreference
            app:key="audio_source"
            app:title="Audio Source"
            app:defaultValue="mic"
            app:entries="@array/audio_source_entries"
            app:entryValues="@array/audio_source_values"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="audio_bitrate_kbps"
            app:title="Audio Bitrate (kbps 32-320)"
            app:dialogTitle="Set Audio Bitrate"
            app:defaultValue="128"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="audio_sample_rate"
            app:title="Audio Sample Rate"
            app:defaultValue="44100"
            app:entries="@array/audio_sample_rate_entries"
            app:entryValues="@array/audio_sample_rate_values"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:key="audio_stereo"
            app:title="Stereo Audio"
            app:summary="Enable dual-channel audio capture when supported"
            app:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
